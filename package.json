{
  "name": "zenith-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend start\" \"pnpm --filter zenith dev\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
